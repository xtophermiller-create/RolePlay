# development | production
APP_ENV=development
# Reload templates/static metadata after edits; keep disabled in production.
ROLEPLAY_TRAINER_DEV=0
# Restart the local Flask process after Python edits.
ROLEPLAY_TRAINER_RELOAD=0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret
DATABASE_URL=mysql+pymysql://roleplay:change-me@127.0.0.1:3306/roleplay_trainer?charset=utf8mb4
# Defaults are storage/scenarios and storage/media. In production, uncomment
# absolute paths under <SiteRoot>/shared/storage.
# SCENARIOS_DIR=/absolute/path/to/shared/storage/scenarios
# MEDIA_DIR=/absolute/path/to/shared/storage/media

# Set only after REG.RU confirms the exact trusted reverse-proxy hop count.
TRUSTED_PROXY_COUNT=0
# Comma-separated hostnames/IPs; leave empty for localhost/LAN development.
TRUSTED_HOSTS=
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
HSTS_ENABLED=false

REGISTRATION_MODE=open
REGISTRATION_INVITE_CODE=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_REQUIRED=false

MAX_REQUEST_BYTES=2097152
MAX_JSON_BYTES=1048576
MAX_AVATAR_BYTES=2097152
MAX_AVATAR_PIXELS=16000000
MAX_AVATAR_DIMENSION=8192
MAX_SCENARIO_BYTES=1048576
AUTH_WINDOW_SECONDS=900
AUTH_MAX_FAILURES=5
AUTH_BLOCK_SECONDS=900
SESSION_INVITE_TTL_SECONDS=30
# Lobby heartbeat timeout and active-session disconnect grace period.
SESSION_PRESENCE_TIMEOUT_SECONDS=60
SESSION_PRESENCE_ACTIVE_TIMEOUT_SECONDS=90
# Guest accounts expire this many seconds after created_at (24 hours).
GUEST_TTL_SECONDS=86400
