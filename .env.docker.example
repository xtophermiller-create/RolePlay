# Local Docker development only. Copy this file to .env.docker before starting.
# Do not reuse these placeholder values in production or commit .env.docker.
APP_ENV=development
SECRET_KEY=replace-with-a-random-local-secret-at-least-32-characters
ROLEPLAY_TRAINER_DEV=1
ROLEPLAY_TRAINER_RELOAD=0

MYSQL_DATABASE=roleplay_trainer
MYSQL_USER=roleplay
MYSQL_PASSWORD=replace-with-a-random-local-database-password
MYSQL_RANDOM_ROOT_PASSWORD=yes
DATABASE_URL=mysql+pymysql://roleplay:replace-with-a-random-local-database-password@db:3306/roleplay_trainer?charset=utf8mb4
# The image defaults to these bind-mounted storage paths.
# SCENARIOS_DIR=/app/storage/scenarios
# MEDIA_DIR=/app/storage/media

# Direct LAN access has no trusted reverse proxy and uses plain HTTP.
TRUSTED_PROXY_COUNT=0
TRUSTED_HOSTS=
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
HSTS_ENABLED=false

REGISTRATION_MODE=open
REGISTRATION_INVITE_CODE=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_REQUIRED=false

MAX_REQUEST_BYTES=2097152
MAX_JSON_BYTES=1048576
MAX_AVATAR_BYTES=2097152
MAX_AVATAR_PIXELS=16000000
MAX_AVATAR_DIMENSION=8192
MAX_SCENARIO_BYTES=1048576
AUTH_WINDOW_SECONDS=900
AUTH_MAX_FAILURES=5
AUTH_BLOCK_SECONDS=900
SESSION_INVITE_TTL_SECONDS=30
SESSION_PRESENCE_TIMEOUT_SECONDS=20
SESSION_PRESENCE_ACTIVE_TIMEOUT_SECONDS=10
GUEST_TTL_SECONDS=86400
